{
  "name": "ailbum-desktop",
  "version": "0.3.0",
  "private": true,
  "description": "Fast local photo selection UI for Ailbum",
  "author": "Ailbum contributors",
  "license": "MIT",
  "homepage": "https://github.com/summerisgone/ailbum",
  "repository": {
    "type": "git",
    "url": "https://github.com/summerisgone/ailbum.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env AILBUM_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-builder --publish never",
    "package:msi": "npm run build && electron-builder --win msi --publish never",
    "package:dmg": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never --config.mac.identity=- --config.mac.hardenedRuntime=false",
    "package:deb": "npm run build && electron-builder --linux deb --publish never"
  },
  "build": {
    "appId": "io.github.ailbum.desktop",
    "productName": "Ailbum",
    "executableName": "ailbum",
    "asar": true,
    "directories": {
      "buildResources": "build-resources",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../build/backend/ailbum-backend",
        "to": "backend"
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "*.onnx"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "icon": "icon.svg",
      "category": "public.app-category.photography",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "icon.svg",
      "target": [
        "msi"
      ]
    },
    "msi": {
      "upgradeCode": "{3B1F532E-D4A7-4B65-9E2D-885573D7B4A4}",
      "oneClick": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false
    },
    "linux": {
      "icon": "icon.svg",
      "target": [
        "deb"
      ],
      "category": "Graphics",
      "synopsis": "Local photo selection and album curation",
      "maintainer": "Ailbum contributors <noreply@users.noreply.github.com>"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.11",
    "wait-on": "^8.0.1"
  }
}
